{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mymemo",
  "version": "0.1.0",
  "identifier": "com.yusuke.mymemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mymemo",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "resources": { "locales/ja.lproj": "ja.lproj" }
  }
}
