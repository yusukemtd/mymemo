{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mymemo",
  "version": "0.1.0",
  "identifier": "com.yusuke.mymemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mymemo",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "locales/ja.lproj": "ja.lproj"
    },
    "fileAssociations": [
      {
        "name": "テキストファイル",
        "ext": [
          "txt",
          "text",
          "md",
          "markdown",
          "log",
          "csv",
          "tsv",
          "json",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "env",
          "xml",
          "html",
          "htm",
          "css",
          "js",
          "mjs",
          "cjs",
          "ts",
          "jsx",
          "tsx",
          "py",
          "rb",
          "rs",
          "go",
          "java",
          "kt",
          "swift",
          "c",
          "h",
          "cpp",
          "hpp",
          "sh",
          "zsh",
          "bash",
          "sql"
        ],
        "contentTypes": [
          "public.text"
        ],
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
